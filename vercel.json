{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/:path*", "destination": "/index.html" },
    { "source": "/item/:path*", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/api/menu", "headers": [{ "key": "Cache-Control", "value": "s-maxage=60, stale-while-revalidate=300" }] },
    { "source": "/api/menu/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
