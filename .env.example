# PostgreSQL (Vercel Postgres, Neon, or Supabase)
DATABASE_URL="postgresql://user:password@host:5432/saffron?sslmode=require"

# Fixed single-admin credentials for Sunrise Cafe
ADMIN_EMAIL="skyrise@hotel.com"
ADMIN_PASSWORD="sky123"
# Use a long random value in production; it signs the 7-day admin JWT.
SESSION_SECRET="replace-with-a-long-random-string"

# Optional image CDN
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Vercel/Upstash rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Client-side API URL; leave empty for same-origin Vercel functions
VITE_API_URL=""
